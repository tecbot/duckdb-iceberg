# name: test/sql/local/snapshot_properties_setting.test
# description: Validate connection-scoped snapshot properties before changing the setting
# group: [local]

include test/sql/init_requires

query T
select current_setting('iceberg_snapshot_properties');
----
{}

statement ok
set session iceberg_snapshot_properties = '{"application.transaction-id":"txn-001"}';

statement error
set iceberg_snapshot_properties = NULL;
----
not NULL

statement error
