# Failed validation must leave the previous setting intact.
query T
select current_setting('iceberg_snapshot_properties');
----
{"application.transaction-id":"txn-001"}

query T other
select current_setting('iceberg_snapshot_properties');
----
{}

statement ok other
set iceberg_snapshot_properties = '{"other":"connection"}';

# Names are case-sensitive. Empty keys and values and Unicode strings are permitted.
statement ok
set iceberg_snapshot_properties = '{"Tag":"upper","tag":"lower","Operation":"custom","Total-Records":"custom","":"","unicode":"\u00e4"}';

statement ok
set iceberg_snapshot_properties = '{"replacement":"value"}';

query T
select current_setting('iceberg_snapshot_properties');
----
{"replacement":"value"}

statement ok
begin;

statement ok
commit;

