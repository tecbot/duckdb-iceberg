# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/test_snapshot_properties_operations.test
# description: CTAS, UPDATE, DELETE, MERGE, and maintenance use the shared snapshot property path
# group: [transactions]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require json

# This test checks snapshot properties, independent of catalog metadata-log support.
statement ok
set session iceberg_use_metadata_log = false;

statement ok
drop table if exists my_datalake.default.snapshot_properties_operations;

statement ok
set iceberg_snapshot_properties = '{"application.transaction-id":"ctas"}';

statement ok
create table my_datalake.default.snapshot_properties_operations as select range::integer as id from range(3);

statement ok
create temp view operation_summaries as
select json_extract_string(snap, '$."sequence-number"')::BIGINT as seq,
       json_extract(snap, '$.summary') as summary
from (
 select unnest(json_extract(metadata::JSON, '$.snapshots[*]')) as snap
 from iceberg_load_table_response(my_datalake.default.snapshot_properties_operations)
);

query TT
select summary->>'application.transaction-id', summary->>'operation' from operation_summaries;
----
ctas	append

statement ok
set iceberg_snapshot_properties = '{"application.transaction-id":"update"}';

statement ok
update my_datalake.default.snapshot_properties_operations set id = 10 where id = 0;

query T
select summary->>'application.transaction-id' from operation_summaries order by seq desc limit 1;
----
update

statement ok
set iceberg_snapshot_properties = '{"application.transaction-id":"delete"}';

statement ok
delete from my_datalake.default.snapshot_properties_operations where id = 1;

query TT
select summary->>'application.transaction-id', summary->>'operation' from operation_summaries order by seq desc limit 1;
----
delete	delete

statement ok
set variable pre_merge_seq = (select max(seq) from operation_summaries);

statement ok
set iceberg_snapshot_properties = '{"application.transaction-id":"merge"}';

statement ok
begin;

statement ok
merge into my_datalake.default.snapshot_properties_operations as target
using (values (10, 11), (20, 20)) as source(id, replacement)
on target.id = source.id
when matched then update set id = source.replacement
when not matched then insert values (source.replacement);

statement ok
reset iceberg_snapshot_properties;

statement ok
commit;

# MERGE may create more than one snapshot. Every snapshot must carry the same properties.
query II
select count(*) > 0, bool_and(summary->>'application.transaction-id' = 'merge')
from operation_summaries where seq > getvariable('pre_merge_seq');
----
true	true

query I
select id from my_datalake.default.snapshot_properties_operations order by id;
----
2
11
20

statement ok
drop table my_datalake.default.snapshot_properties_operations;

statement ok
drop table if exists my_datalake.default.snapshot_properties_maintenance;

statement ok
create table my_datalake.default.snapshot_properties_maintenance (id integer);

loop i 0 6

statement ok
insert into my_datalake.default.snapshot_properties_maintenance values ({i});

endloop

statement ok
set iceberg_snapshot_properties = '{"application.transaction-id":"compact"}';

statement ok
begin;

query III
call iceberg_rewrite_data_files('my_datalake.default.snapshot_properties_maintenance');
----
6	1	<REGEX>:[1-9][0-9]*

statement ok
reset iceberg_snapshot_properties;

statement ok
commit;

query TT
select json_extract_string(snap, '$.summary."application.transaction-id"'),
       json_extract_string(snap, '$.summary.operation')
from (
 select unnest(json_extract(metadata::JSON, '$.snapshots[*]')) as snap
 from iceberg_load_table_response(my_datalake.default.snapshot_properties_maintenance)
)
order by json_extract_string(snap, '$."sequence-number"')::BIGINT desc limit 1;
----
compact	replace

statement ok
drop table my_datalake.default.snapshot_properties_maintenance;

statement ok
reset session iceberg_use_metadata_log;
